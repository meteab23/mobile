# Polygon.io (required for live market data)
POLYGON_API_KEY=
POLYGON_DATA_MODE=realtime

# AI analysis (at least one recommended)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=file:./data/app.db

# WebSocket server
WS_PORT=3001
WS_SERVER_URL=ws://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
